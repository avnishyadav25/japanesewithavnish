/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files (keep .env.example - it's a template)
.env
.env.*
!.env.example

# Supabase local (if using CLI)
supabase/.temp
supabase/.branches

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
# docs/* (contents), NOT docs/ (the directory). Git does not descend into an excluded
# directory, so a "!docs/FILE" negation under "docs/" is silently ignored — the file stays
# untracked and nobody notices. Excluding the contents keeps the directory walkable so the
# negation below actually applies.
docs/*
# The engineering log is the one doc that MUST be shared: it holds the current architecture,
# the gotchas, and the open backlog that future sessions read before touching databases,
# crons or deploys. Ignored, it would exist on one machine only.
!docs/ENGINEERING_LOG.md
# The playbook and the manual-steps guide are written to be READ BY OTHER PEOPLE and reused on
# other projects — that is the whole reason they exist. Ignored, they lived on one laptop while
# commit messages claimed they had shipped, which is the exact failure the note above warns about.
!docs/VIDEO_PIPELINE_PLAYBOOK.md
!docs/VIDEO_MANUAL_STEPS.md
google-cloud-sdk/
google-cloud-cli-*.tar.gz

# backups
/backups
/scripts/backups

japanesewithavnish.com-audit/*
japanesewithavnish.com-audit
japanesewithavnish.com-audit


.avnish-files/*

# Mascot pilot output and brand preview stills — regenerable, never committed.
# public/mascots/*.png IS committed; this is the review scratch area.
video-brand-preview/

# Voice-cloning reference audio. NEVER commit this — the repo is public and a clean
# 60-second sample is precisely what someone needs to clone the voice. Lives in R2 instead;
# see docs/VIDEO_MANUAL_STEPS.md.
reference/
