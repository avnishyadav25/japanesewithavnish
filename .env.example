# ---------------------------------------------------------------------------
# Databases — app traffic is routed by src/lib/db.ts to whichever provider the
# failover flag says is active. Admin UI: /admin/settings/failover
# ---------------------------------------------------------------------------

# Primary Postgres (required). Pooled connection — this serves all app queries.
DATABASE_URL=

# Primary DIRECT (non-pooler) connection. Schema-parity checks and replication
# DDL only — never app query traffic (src/lib/db/providers.ts). For Neon this is
# DATABASE_URL with "-pooler" dropped from the host.
DATABASE_URL_DIRECT=

# Standby Postgres (Supabase). Until SUPABASE_DATABASE_URL is set, Supabase is
# never selectable as the active provider and the app stays single-provider.
# MUST be the pooler host (port 6543) — the direct db.<ref>.supabase.co host is
# IPv6-only and therefore unreachable from Netlify Functions.
SUPABASE_DATABASE_URL=
# Supabase direct-equivalent, for DDL / pg_dump / pg_restore. Use the SESSION-mode
# pooler (same host as above, port 5432) — NOT db.<ref>.supabase.co, which is
# IPv6-only and unresolvable from Netlify Functions and most IPv4 networks.
SUPABASE_DB_URL=

# Supabase REST — used by the archival backup writer in src/lib/db-backup.ts.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Turso (libSQL) holds the failover routing flag AND a full archival snapshot.
# If Turso is unreachable at cold start, routing falls back to
# DB_PROVIDER_FALLBACK (src/lib/db/resolve-provider.ts).
TURSO_DB_URL=
TURSO_DB_AUTH_TOKEN=
TURSO_DB_NAME=

# Which provider to serve if Turso can't be read on a cold start. Default "neon".
# DB_PROVIDER_FALLBACK=neon

# Email (SMTP). Optional: Resend API in backlog for future.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Japanese with Avnish <support@japanesewithavnish.com>

# Razorpay (test mode). If unset, checkout uses manual UPI flow.
RAZORPAY_KEY_ID=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Keep disabled in production unless you intentionally expose /api/create-order for a custom flow.
ALLOW_GENERIC_RAZORPAY_ORDER_ENDPOINT=false

# Manual UPI (when Razorpay not configured). Default UPI ID: japanesewithavnish@ybl. Put QR at public/upi-qr.png.
NEXT_PUBLIC_UPI_ID=japanesewithavnish@ybl

# Stripe (feature flag OFF for MVP)
STRIPE_ENABLED=false
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Admin (comma-separated emails) + shared admin-panel password
ADMIN_EMAILS=your@email.com
ADMIN_PASSWORD=

# E2E testing (Phase 10): admin and test students — set for Browser MCP / Playwright e2e
# Admin must be in ADMIN_EMAILS; students must exist (sign up first or seed)
# E2E_BASE_URL=http://localhost:3001
# E2E_ADMIN_EMAIL=admin@example.com
# E2E_ADMIN_PASSWORD=your-admin-password
# E2E_STUDENT_1_EMAIL=student1@test.example.com
# E2E_STUDENT_1_PASSWORD=testpass123
# E2E_STUDENT_2_EMAIL=student2@test.example.com
# E2E_STUDENT_2_PASSWORD=testpass123
# E2E_STUDENT_3_EMAIL=student3@test.example.com
# E2E_STUDENT_3_PASSWORD=testpass123

# Session/access-token signing secret (required — app refuses to start without it; use a long random string)
ACCESS_TOKEN_SECRET=

# Site URL (for sitemap, emails, magic links)
NEXT_PUBLIC_SITE_URL=https://japanesewithavnish.com

# Cron — REQUIRED. Every /api/cron/* route returns 401 without it, so backups,
# replication sync, newsletters and the review worker all silently stop.
# Schedules are driven by .github/workflows/crons.yml (and n8n on the VPS), which
# authenticate as: Authorization: Bearer $CRON_SECRET  (or ?key=$CRON_SECRET).
# Must ALSO be set as a GitHub Actions repo secret named CRON_SECRET.
CRON_SECRET=

# Marketing, ads & analytics (optional; see docs/MARKETING_ANALYTICS_GUIDE.md)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=
# NEXT_PUBLIC_GTM_ID=
# NEXT_PUBLIC_ADSENSE_CLIENT_ID=
# NEXT_PUBLIC_META_PIXEL_ID=
# NEXT_PUBLIC_MONETAG_TAG=

# Coming soon mode (true = show coming soon on home, false = full site)
COMING_SOON=true

# AI (optional — for admin content generation)
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
# For image generation: gemini-2.0-flash-preview-image-generation (default)
GEMINI_IMAGE_MODEL=
# OpenRouter (content/image generation for seeder scripts)
OPENROUTER_API_KEY=

# Dev only: LOCALTEST=true makes /api/learn/curriculum treat requests as
# logged-in without a session. Ignored in production builds — never set in prod.
# LOCALTEST=false

# Cloudflare R2 (for AI-generated images and migrated storage)
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_BUCKET_URL=

# Bundle Google Drive links (7 bundles — add your share links)
BUNDLE_FREE_STARTER_KIT_DRIVE_URL=
BUNDLE_MEGA_DRIVE_URL=
BUNDLE_N5_DRIVE_URL=
BUNDLE_N4_DRIVE_URL=
BUNDLE_N3_DRIVE_URL=
BUNDLE_N2_DRIVE_URL=
BUNDLE_N1_DRIVE_URL=

# ---------------------------------------------------------------------------
# Video Studio (/admin/video)
# ---------------------------------------------------------------------------
# Google Cloud Text-to-Speech, for AI voiceover. If you already have a Google
# service account for the Sheets export, you can enable the Cloud
# Text-to-Speech API on that same GCP project and leave these blank — the TTS
# layer falls back to GOOGLE_SHEETS_SERVICE_ACCOUNT_* automatically.
GOOGLE_TTS_SERVICE_ACCOUNT_EMAIL=
GOOGLE_TTS_SERVICE_ACCOUNT_PRIVATE_KEY=

# Optional. Lets the admin panel trigger the GitHub Actions render worker the
# moment a job is queued, instead of waiting for the 15-minute schedule.
# Needs a fine-grained PAT with "Contents: read and write" on this repo.
GITHUB_DISPATCH_TOKEN=
GITHUB_DISPATCH_REPO=avnishyadav25/japanesewithavnish

# Where the render worker points Playwright when capturing real-page B-roll
# (Phase 4). Defaults to the production site. The cookie is an admin
# auth_session value, only needed to capture premium/gated pages.
VIDEO_CAPTURE_BASE_URL=https://japanesewithavnish.com
VIDEO_CAPTURE_ADMIN_COOKIE=

# Music library. Jamendo is the only one of the supported sources with a usable music API —
# Pixabay's public API covers images and video only, and DOVA-SYNDROME has none, so both of
# those are download-then-import-by-URL. Free client ID: https://devportal.jamendo.com
JAMENDO_CLIENT_ID=

# ---------------------------------------------------------------------------
# Social engine
# ---------------------------------------------------------------------------

# Seals OAuth refresh tokens in social_channels.credentials_sealed (AES-256-GCM).
# Generate: openssl rand -base64 32
# MUST also be set in the GitHub Actions secrets the publish worker runs with — if only the app
# has it, the admin UI looks healthy while the worker cannot publish anything.
SOCIAL_TOKEN_KEY=

# YouTube auto-upload. Create a "Web application" OAuth client in the SAME Google Cloud project
# as the TTS service account, and add this redirect URI:
#   https://japanesewithavnish.com/api/admin/social/oauth/callback/youtube
# Uploads stay private until the API project passes Google's audit, and the default quota
# (10,000 units/day at 1,600 per upload) caps you at six videos a day.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Circuit breaker on LLM spend for social copy, in USD per rolling 24h. Mirrors
# REVIEW_DAILY_COST_CAP_USD. Generating every surface for a batch of briefs is a lot of calls
# behind one click. Default 3.
SOCIAL_DAILY_COST_CAP_USD=3

# Set to "off" to stop the render worker writing captions automatically when a video finishes.
# Left unset, each completed render gets an Instagram Reel, a YouTube Short and an X post in
# both English and Hinglish — roughly $0.002 a video.
SOCIAL_AUTOGEN=
